// DEFINE ipset dichiara un insieme di indirizzi IP
DEFINE ipset server_flask = { *.*.*.*:32456 };
DEFINE ipset tuttigliip = { *.*.*.*:* };

DEFINE set pattern_da_bloccare = {
    // Vettori SQL Injection
    "'", "%27", "UNION", "union", "ORDER BY", "order by", "--", "1=1", "1%3D1"
};

// 1. REGOLA PER IL TRAFFICO SICURO
// La funzione restituisce TRUE se NON trova minacce. In tal caso, inoltriamo a Flask!
DEFINE AR "Passa_Tutto_Sicuro"
    CONDITION
        net.ipdst is in tuttigliip
        CALL "va::vaeng::fast-scan-stringset" WITH "checkuri", "pattern_da_bloccare", "false", http.uri, "false"
    ACTION
        tcp.redirect "127.0.0.1:5020"
    ;

// 2. REGOLA DI BLOCCO (Catch-All)
// Se la regola sopra ha restituito FALSE (attacco rilevato!), la richiesta viene ignorata 
// dalla prima regola, cade in questa seconda regola e viene bloccata.
DEFINE AR "BucoNero_SQLi"
    CONDITION
        net.ipdst is in tuttigliip
    ACTION
        ANSWER "<p>🔴 ATTACCO INTERCETTATO E NEUTRALIZZATO DAL WAF.</p>"
    ;

// 3. REGOLA DI LOGGING
DEFINE VR PrintAll
    CONDITION
        obs.event is net.send
    ACTION
        REPORT log { CAT { 
            http.header["0_FULL_DATA"], 
            " - ",
            http.data["0_FULL_DATA"]
        }}
    ;