// Definizione degli IP e porte
DEFINE ipset miosito = { *.*.*.*:32456 };

// Blacklist delle firme SQL Injection (URL-Encoded e stringhe esatte)
DEFINE set blacklist = { 
    "'", "%27", 
    "--", "%2D%2D", 
    ";", "%3B",
    "union", "select", 
    "%27OR%271%27%3D%271",  
    "%27+OR+1%3D1",         
    "%27%20OR%201%3D1",
    "aaa' OR 1=1",
    "aaa%27+OR+1%3D1"
};

// REGOLA 1: Blocco password
DEFINE AR BlockPasswordSQLi
    CONDITION
        http.query["password"] is in blacklist
    ACTION
        ANSWER "<html><body style='background:#1a0000;color:red;padding:50px;text-align:center;font-family:monospace;'><h1>403 Forbidden</h1><p>WAF SMART BLOCK: Rilevata firma SQL Injection nota nel campo Password.</p></body></html>"
    ;

// REGOLA 2: Blocco username
DEFINE AR BlockUserSQLi
    CONDITION
        http.query["username"] is in blacklist
    ACTION
        ANSWER "<html><body style='background:#1a0000;color:red;padding:50px;text-align:center;font-family:monospace;'><h1>403 Forbidden</h1><p>WAF SMART BLOCK: Rilevata firma SQL Injection nota nel campo Username.</p></body></html>"
    ;

// REGOLA 3: Inoltro traffico pulito
DEFINE AR ForwardTraffic
    CONDITION
        net.ipdst is in miosito
    ACTION
        tcp.redirect "127.0.0.1:5020"
    ;


// REGOLA VIRTUALE: Logga nel terminale Docker solo il traffico "pulito"
DEFINE VR LogTrafficoPulito
    CONDITION
        obs.event is net.send
    ACTION
        REPORT log { CAT { "[WAF] Traffico sicuro inoltrato a Flask: ", http.method, " ", http.url } }
    ;