define set pagine_consentite = {
    "/api_v1.php", "/info_page_1.html",  "/info_page_5.html",  "/info_page_9.html",  "/report.php", "/dashboard.php", "/info_page_2.html",  "/info_page_6.html",  "/login.php",         "/search.php", "/export.php", "/info_page_3.html",  "/info_page_7.html",  "/news.php",          "/settings.php", "/info_page_10.html",  "/info_page_4.html",  "/info_page_8.html",  "/profile.php", "/upload.php"
};

DEFINE AR "Aperto"
    CONDITION
        http.url is in pagine_consentite
    ACTION
        tcp.redirect "10.10.10.10:80"
    ;

DEFINE ipset serverip = { *.*.*.*:* };
DEFINE AR "BucoNero"
    CONDITION
        net.ipdst is in serverip
    ACTION
        ANSWER "<p>Richiesta accettata correttamente</p>"
    ;
